# ============================================================
#  העתק קובץ זה ל-.env והכנס את המפתחות שלך
#  ב-Render תוסיף אותם ב-Dashboard → Environment
# ============================================================

# --- אפשרות מומלצת: כמה מפתחות מופרדים בפסיק ---
OPENAI_API_KEYS=sk-key1-here,sk-key2-here,sk-key3-here

# --- או כל מפתח בנפרד ---
# OPENAI_API_KEY_1=sk-first-key
# OPENAI_API_KEY_2=sk-second-key
# OPENAI_API_KEY_3=sk-third-key

# מודל (אופציונלי)
OPENAI_MODEL=gpt-4o-mini
